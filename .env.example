# 登录本应用的账号，多个用户用英文逗号分隔：user1:pass1,user2:pass2
APP_USERS=admin:admin123
APP_JWT_SECRET=please-change-to-a-long-random-string
CONFIG_PATH=/data/config.json

# 后台自动注入 Emby / TMDB 配置
EMBY_URL=http://your-emby:8096
EMBY_API_KEY=
EMBY_USER_ID=
TMDB_API_KEY=

# 缺集扫描：定时扫描开关、间隔小时数、是否只跑最近变更；屏蔽的媒体库填库 ID 或库名，逗号分隔
SCAN_AUTO_ENABLED=false
SCAN_AUTO_INTERVAL_HOURS=12
SCAN_AUTO_RECENT_ONLY=true
SCAN_EXCLUDED_LIBRARIES=

# MoviePilot 站点搜索、下载和订阅联动
MP_URL=
MP_TOKEN=
MP_DOWNLOAD_TIMEOUT_SECONDS=90
